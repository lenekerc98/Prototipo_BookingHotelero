{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src vite.config.ts vitest.config.ts playwright.config.ts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "security:audit": "npm audit --audit-level=high",
    "qa": "npm run typecheck && npm run lint && npm test && npm run build",
    "qa:full": "npm run qa && npm run test:e2e && npm run security:audit"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
